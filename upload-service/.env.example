# Copy to .env and fill in. THIS FILE STAYS ON THE SERVER - it is never bundled
# into the browser, which is the whole point of this service.

# Pinata JWT. Needs BOTH pinFileToIPFS AND pinJSONToIPFS scopes (or Admin).
PINATA_JWT=your_pinata_jwt_here

# Port the service listens on (the frontend's VITE_UPLOAD_SERVICE_URL must match).
PORT=8787

# CORS allowlist. Comma-separated origins, or * for local dev.
# e.g. ALLOWED_ORIGIN=http://localhost:5173,https://your-frontend-host
ALLOWED_ORIGIN=*

# Orphan cleanup TTL (ms). Pins still unconfirmed after this are unpin candidates.
# Default 24h.
PENDING_TTL_MS=86400000
